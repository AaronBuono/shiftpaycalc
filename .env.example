# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# Supabase Postgres — set automatically by the Vercel ↔ Supabase integration.
# POSTGRES_URL is the pooled connection (port 6543) the app uses;
# POSTGRES_URL_NON_POOLING is the direct connection used by `npm run db:migrate`.
# Leave both unset locally to use the embedded PGlite database in ./.pglite
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Better Auth: `openssl rand -base64 32`, and the site's public URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The only email that can sign up without an invite (the owner/admin)
ADMIN_EMAIL=

# Encrypts calendar links at rest: `openssl rand -base64 32`
ENCRYPTION_KEY=

# Vercel Cron sends this as a Bearer token: `openssl rand -hex 32`
CRON_SECRET=

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
